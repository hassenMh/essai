/* ══════════════════════════════════════════════════════
   StoreManager Pro — Light Retail Theme
   ══════════════════════════════════════════════════════ */

/* ── Global reset ── */
* {
    font-family: "Segoe UI", "Inter", "Ubuntu", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    outline: none;
}

QLabel {
    background: transparent;
    border: none;
    padding: 0;
    color: #334155;
}

QMainWindow, QDialog {
    background-color: #F1F5F9;
    color: #1E293B;
}

QWidget {
    color: #334155;
}

QStackedWidget > QWidget,
QScrollArea > QWidget > QWidget {
    background-color: #F1F5F9;
}

/* ── Sidebar ── */
#sidebar {
    background-color: #0F172A;
    border-right: none;
    min-width: 230px;
    max-width: 230px;
}

#sidebarLogo { font-size: 38px; }

#sidebarTitle {
    font-size: 16px;
    font-weight: 700;
    color: #00C48C;
    letter-spacing: 0.5px;
}

#sidebarVersion { font-size: 11px; color: #334155; }

QPushButton#navBtn {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    text-align: left;
    padding: 13px 20px;
    color: #64748B;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#navBtn:hover {
    background: rgba(0, 196, 140, 0.08);
    color: #CBD5E1;
    border-left-color: rgba(0, 196, 140, 0.3);
}
QPushButton#navBtn:checked {
    background: rgba(0, 196, 140, 0.15);
    color: #00C48C;
    font-weight: 700;
    border-left-color: #00C48C;
}

#userPanel {
    background: #060D18;
    border-top: 1px solid #1E293B;
}

#userNameLabel { font-size: 13px; font-weight: 600; color: #CBD5E1; background: transparent; }
#userRoleLabel { font-size: 11px; color: #475569; background: transparent; }

QPushButton#btnLogout {
    background: rgba(239, 68, 68, 0.12);
    border: 1.5px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    padding: 8px 14px;
    color: #EF4444;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#btnLogout:hover {
    background: rgba(239, 68, 68, 0.25);
    border-color: #EF4444;
    color: #FCA5A5;
}

/* ── Top Bar ── */
#topBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 58px;
    max-height: 58px;
}

#pageTitle { font-size: 19px; font-weight: 700; color: #1E293B; background: transparent; }
#clockLabel { font-size: 13px; color: #94A3B8; background: transparent; }

/* ── Stat Cards ── */
#statCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}
#statCard:hover { border-color: #00C48C; }

#cardValue { font-size: 26px; font-weight: 700; background: transparent; }
#cardLabel { font-size: 12px; color: #94A3B8; font-weight: 500; background: transparent; }
#cardIcon  { font-size: 30px; background: transparent; }

/* Dashboard rows */
#dashRow {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

/* ── Tables ── */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    gridline-color: #F1F5F9;
    selection-background-color: rgba(5, 150, 105, 0.08);
    color: #334155;
}
QTableWidget::item {
    padding: 10px 8px;
    color: #334155;
    border: none;
    background: transparent;
}
QTableWidget::item:selected { background-color: rgba(5, 150, 105, 0.1); color: #1E293B; }
QTableWidget::item:hover { background-color: rgba(5, 150, 105, 0.05); }

QHeaderView::section {
    background-color: #F8FAFC;
    color: #94A3B8;
    font-weight: 600;
    font-size: 11px;
    padding: 12px 8px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}
QHeaderView { background: transparent; }
QTableWidget QTableCornerButton::section { background: #F8FAFC; border: none; }

/* ── Inputs ── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QDateEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    padding: 9px 12px;
    color: #1E293B;
    selection-background-color: #059669;
    selection-color: white;
    min-height: 36px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QDateEdit:focus {
    border-color: #059669;
}
QLineEdit:disabled, QComboBox:disabled {
    color: #CBD5E1;
    background-color: #F8FAFC;
    border-color: #E2E8F0;
}

QComboBox::drop-down { border: none; width: 28px; background: transparent; }
QComboBox::down-arrow {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #94A3B8;
    width: 0; height: 0;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    selection-background-color: rgba(5, 150, 105, 0.1);
    color: #1E293B;
    outline: none;
}

QDateEdit::drop-down { border: none; width: 28px; background: transparent; }
QCalendarWidget { background: #FFFFFF; color: #1E293B; border: 1px solid #E2E8F0; }
QCalendarWidget QToolButton { color: #1E293B; background: transparent; }
QCalendarWidget QAbstractItemView {
    background: #FFFFFF; color: #1E293B;
    selection-background-color: #059669; selection-color: white;
}

/* ── Buttons ── */
QPushButton {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-weight: 700;
    font-size: 13px;
    min-height: 36px;
}
QPushButton:hover   { background-color: #10B981; }
QPushButton:pressed { background-color: #047857; }
QPushButton:disabled { background-color: #E2E8F0; color: #CBD5E1; }

QPushButton#btnDanger  { background-color: #EF4444; color: white; }
QPushButton#btnDanger:hover  { background-color: #F87171; }
QPushButton#btnSuccess { background-color: #059669; color: white; }
QPushButton#btnSuccess:hover { background-color: #10B981; }
QPushButton#btnWarning { background-color: #F59E0B; color: #1E293B; font-weight: 700; }
QPushButton#btnWarning:hover { background-color: #FBBF24; }

QPushButton#btnSecondary {
    background-color: transparent;
    border: 1.5px solid #E2E8F0;
    color: #64748B;
    font-weight: 600;
}
QPushButton#btnSecondary:hover {
    border-color: #059669;
    color: #1E293B;
    background: rgba(5, 150, 105, 0.05);
}

QPushButton#btnIcon {
    background: transparent;
    border: none;
    padding: 5px;
    border-radius: 6px;
    font-size: 16px;
    color: #94A3B8;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}
QPushButton#btnIcon:hover { background: rgba(5, 150, 105, 0.08); color: #059669; }

/* ── Scrollbar ── */
QScrollBar:vertical { background: transparent; width: 6px; border-radius: 3px; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #059669; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 6px; border-radius: 3px; }
QScrollBar::handle:horizontal { background: #CBD5E1; border-radius: 3px; }
QScrollBar::handle:horizontal:hover { background: #059669; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Tabs ── */
QTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #94A3B8;
    padding: 10px 22px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
    font-size: 13px;
}
QTabBar::tab:selected { color: #059669; border-bottom-color: #059669; font-weight: 700; }
QTabBar::tab:hover:!selected { color: #475569; background: rgba(5, 150, 105, 0.04); }

/* ── Dialogs ── */
QMessageBox { background: #FFFFFF; }
QMessageBox QLabel { color: #1E293B; background: transparent; }
QMessageBox QPushButton { min-width: 90px; }

/* ── Separators ── */
QFrame#separator { background: #E2E8F0; max-height: 1px; border: none; }

/* ── Search bar ── */
QLineEdit#searchBar {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 24px;
    padding: 10px 16px;
    font-size: 14px;
    color: #1E293B;
}
QLineEdit#searchBar:focus { border-color: #059669; }

/* ── POS Cart ── */
#cartPanel {
    background: #FFFFFF;
    border-left: 1px solid #E2E8F0;
    min-width: 380px;
    max-width: 380px;
}
#cartHeader {
    background: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}

#cartTotalPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #059669, stop:1 #047857);
    border-radius: 14px;
    margin: 10px;
    padding: 16px;
    border: none;
}

#cartTotalPanel QLabel {
    background: transparent;
    border: none;
    padding: 0;
    color: white;
}

#cartTotalLabel {
    font-size: 26px;
    font-weight: 700;
    color: white;
    background: transparent;
    border: none;
    padding: 0;
}

#cartSubtotalLabel {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.78);
    background: transparent;
    border: none;
    padding: 0;
}

/* ── Badges ── */
QLabel#badge { background-color: #EF4444; color: white; border-radius: 10px; padding: 2px 8px; font-size: 11px; font-weight: 700; border: none; }
QLabel#badgeSuccess { background-color: #059669; color: white; border-radius: 10px; padding: 2px 8px; font-size: 11px; border: none; }
QLabel#badgeWarning { background-color: #F59E0B; color: #1E293B; border-radius: 10px; padding: 2px 8px; font-size: 11px; font-weight: 700; border: none; }
QLabel#badgeInfo { background-color: #0EA5E9; color: white; border-radius: 10px; padding: 2px 8px; font-size: 11px; border: none; }

/* ── Alerts ── */
#alertLow { background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 10px 14px; }
#alertWarning { background: rgba(245, 158, 11, 0.06); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 10px 14px; }

/* ── Tooltips ── */
QToolTip {
    background: #1E293B;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── CheckBox / RadioButton ── */
QCheckBox, QRadioButton { color: #475569; spacing: 8px; font-size: 13px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px; height: 18px;
    border: 2px solid #CBD5E1;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked { background: #059669; border-color: #059669; }
QRadioButton::indicator { border-radius: 9px; }
QRadioButton::indicator:checked { background: #059669; border-color: #059669; }

/* ── GroupBox ── */
QGroupBox {
    border: 1.5px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 16px;
    padding-top: 16px;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: transparent;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    background: transparent;
}

/* ── ProgressBar ── */
QProgressBar { background: #E2E8F0; border-radius: 6px; border: none; height: 8px; color: transparent; }
QProgressBar::chunk { background: #059669; border-radius: 6px; }

/* ── Menu ── */
QMenu {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 4px;
    color: #1E293B;
}
QMenu::item { padding: 8px 24px; border-radius: 4px; }
QMenu::item:selected { background: rgba(5, 150, 105, 0.08); color: #059669; }
QMenu::separator { background: #E2E8F0; height: 1px; margin: 4px 0; }
